# DOIP MVP backend base URL. Optional — the app runs fully offline without it.
# Default when unset: http://localhost:8000
VITE_DOIP_API_URL=http://localhost:8000

# Optional: ArcGIS Online API key for Esri World Imagery.
# If omitted or empty, DOIP automatically falls back to unwatermarked satellite & CARTO dark tiles.
VITE_ARCGIS_API_KEY=
